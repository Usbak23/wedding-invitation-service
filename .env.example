# Application
NODE_ENV=production
APP_ENV=production
APP_PORT=3010
PORT=3010
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3000
SWAGGER_ENV=production

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME=wedding-invitation-db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# S3 Storage (MinIO / AWS S3)
S3_ENDPOINT=https://minio.amtechsolutions.my.id
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET=wedding
S3_REGION=us-east-1
